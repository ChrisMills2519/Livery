# Godot 4+ specific ignores
.godot/
/android/

# Python
__pycache__/
*.py[cod]

# Local response dumps
_respdump/

# Blender working files
*.blend
*.blend1

# Exported builds, published by tools/deploy_r2.py
build/

# Netlify CLI state from the old host; nothing deploys there any more, but an
# old checkout may still have the linked site id here
.netlify/

# Review renders and other throwaway artifacts
artifacts/

# Temporary debug renders and shaders
artifacts/_dbg_*
res/shaders/_fp_probe.*

# Publishing credentials for tools/deploy_r2.py and tools/release.sh: never commit
.env
.env.local

# Agent skill bundles pulled by .agents/mcp.json; restorable from skills-lock.json
.agents/skills/

# Local agent/editor state
.claude/
